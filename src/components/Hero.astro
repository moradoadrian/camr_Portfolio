---

---

<section
  class="min-h-screen flex flex-col justify-center items-center relative overflow-hidden px-4 py-24 md:py-32"
>
  <div
    class="z-10 flex flex-col md:flex-row items-center gap-8 md:gap-16 max-w-6xl mx-auto"
  >
    <!-- Profile Image -->
    <div
      class="hero-image relative w-64 h-64 md:w-[350px] md:h-[350px] shrink-0 opacity-0 scale-50"
    >
      <div
        class="absolute inset-0 bg-purple-600 opacity-20 translate-x-3 translate-y-3"
      >
      </div>
      <img
        src="/1757554006561.jpg"
        alt="Cesar Adrian Morado Rodriguez"
        class="relative w-full h-full object-cover border-2 border-purple-500 hover:scale-105 transition-transform duration-500"
      />
      <!-- Corner Accents -->
      <div
        class="absolute -top-2 -left-2 w-4 h-4 border-t-2 border-l-2 border-purple-500"
      >
      </div>
      <div
        class="absolute -bottom-2 -right-2 w-4 h-4 border-b-2 border-r-2 border-purple-500"
      >
      </div>
    </div>

    <!-- Text Content -->
    <div class="text-center md:text-left">
      <h2
        class="hero-subtitle text-xl md:text-2xl text-purple-400 font-pixel mb-2 opacity-0 translate-y-10"
        data-i18n="hero.subtitle"
      >
        &lt;Hola_Mundo /&gt;
      </h2>
      <h1
        class="hero-title text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold font-pixel text-white mb-4 opacity-0 translate-y-10 tracking-tight leading-tight"
      >
        <span class="hero-first-name block"></span>
        <span class="hero-last-name block text-purple-500"></span>
      </h1>
      <p
        class="hero-role text-lg md:text-xl text-slate-300 mb-4 opacity-0 translate-y-10 font-mono border-l-2 border-purple-500 pl-4"
      >
        &gt; <span data-i18n="hero.role">Software Engineer | Angular · TypeScript · Firebase</span><span class="animate-pulse">_</span>
      </p>
      
      <p
        class="hero-description text-sm md:text-base text-slate-400 mb-6 max-w-xl leading-relaxed font-mono opacity-0 translate-y-10 text-justify md:text-left"
        data-i18n="hero.description"
      >
        I build scalable web applications focused on performance, user experience, and clean architecture for government institutions and private companies.
      </p>

      <!-- Location, availability, target title info -->
      <div class="hero-info flex flex-wrap gap-4 text-xs font-mono text-slate-400 mb-6 justify-center md:justify-start opacity-0 translate-y-10">
        <span class="flex items-center gap-1 bg-slate-900/60 border border-slate-800 px-2.5 py-1 rounded">
          <span data-i18n="hero.location">Guanajuato, México 🇲🇽</span>
        </span>
        <span class="flex items-center gap-1 bg-slate-900/60 border border-slate-800 px-2.5 py-1 rounded">
          <span data-i18n="hero.availability">Disponible para oportunidades 🟢</span>
        </span>
        <span class="flex items-center gap-1 bg-slate-900/60 border border-slate-800 px-2.5 py-1 rounded">
          <span data-i18n="hero.targetTitle">Angular Frontend Developer 💼</span>
        </span>
      </div>

      <!-- Badges -->
      <div class="hero-badges flex flex-wrap gap-3 mb-8 justify-center md:justify-start opacity-0 translate-y-10 font-mono">
        <span class="px-2.5 py-1 bg-purple-950/20 border border-purple-500/30 text-purple-400 text-xs rounded hover:border-purple-500/60 transition-colors cursor-default">
          <span data-i18n="hero.badgeExp">Experiencia: +4 años</span>
        </span>
        <span class="px-2.5 py-1 bg-purple-950/20 border border-purple-500/30 text-purple-400 text-xs rounded hover:border-purple-500/60 transition-colors cursor-default">
          <span data-i18n="hero.badgeCerts">Certificaciones: 5</span>
        </span>
        <span class="px-2.5 py-1 bg-purple-950/20 border border-purple-500/30 text-purple-400 text-xs rounded hover:border-purple-500/60 transition-colors cursor-default">
          <span data-i18n="hero.badgeProj">Proyectos: 10+</span>
        </span>
      </div>

      <div
        class="hero-buttons flex flex-wrap gap-4 justify-center md:justify-start opacity-0 translate-y-10 font-pixel text-lg"
      >
        <a
          href="#projects"
          class="px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white border-2 border-transparent hover:border-white transition-all transform hover:-translate-y-1"
          data-i18n="hero.btnProjects"
        >
          [ VER_PROYECTOS ]
        </a>
        <a
          href="/Ing-Cesar-Adrian-Morado-Rodriguez-2026.pdf"
          target="_blank"
          class="px-6 py-3 border-2 border-purple-500 text-purple-400 hover:bg-purple-500/10 transition-all transform hover:-translate-y-1"
          data-i18n="hero.btnCv"
        >
          [ DESCARGAR_CV ]
        </a>
        <a
          href="#contact"
          class="px-6 py-3 border-2 border-slate-700 text-slate-400 hover:border-purple-500 hover:text-purple-400 hover:bg-purple-950/20 transition-all transform hover:-translate-y-1"
          data-i18n="hero.btnContact"
        >
          [ CONTACTARME ]
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-10 animate-bounce">
    <a href="#about" aria-label="Ir a sección Sobre Mí">
      <svg
        class="w-6 h-6 text-purple-500"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7-7-7m14-6l-7 7-7-7"
        ></path>
      </svg>
    </a>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  /**
   * Typewriter effect — animates PLAIN TEXT only.
   * Never pass HTML strings to this function.
   */
  const typeWriterPlain = (
    element: HTMLElement,
    text: string,
    speed = 20,
    callback?: () => void
  ) => {
    element.textContent = "";
    element.classList.remove("opacity-0", "translate-y-10");
    let i = 0;
    const interval = setInterval(() => {
      if (i < text.length) {
        element.textContent += text.charAt(i);
        i++;
      } else {
        clearInterval(interval);
        if (callback) callback();
      }
    }, speed);
  };

  window.addEventListener("loaderComplete", () => {
    // --- Subtitle ---
    const subtitleEl = document.querySelector<HTMLElement>(".hero-subtitle");
    // The subtitle text is plain (e.g. "<Hola_Mundo />") — safe to read as textContent
    const subtitleText = subtitleEl?.textContent?.trim() ?? "<Hola_Mundo />";

    // --- Title: two independent spans for plain-text animation ---
    const firstNameEl  = document.querySelector<HTMLElement>(".hero-first-name");
    const lastNameEl   = document.querySelector<HTMLElement>(".hero-last-name");
    // Make the h1 wrapper visible immediately (it controls layout)
    const titleEl      = document.querySelector<HTMLElement>(".hero-title");
    if (titleEl) titleEl.classList.remove("opacity-0", "translate-y-10");

    const tl = gsap.timeline({ defaults: { ease: "power2.out" } });

    // 1. Photo: fade + scale
    tl.to(".hero-image", { opacity: 1, scale: 1, duration: 0.7 });

    // 2. Typewriter subtitle (plain text)
    if (subtitleEl) {
      typeWriterPlain(subtitleEl, subtitleText, 35, () => {
        // 3. Typewriter firstName then lastName
        if (firstNameEl) {
          typeWriterPlain(firstNameEl, "Cesar Adrian", 25, () => {
            if (lastNameEl) {
              typeWriterPlain(lastNameEl, "Morado Rodriguez", 25);
            }
          });
        }
      });
    }

    // 4. Staggered fade-up for the rest of the hero content
    tl.to(".hero-role",        { opacity: 1, y: 0, duration: 0.4 }, "-=0.3")
      .to(".hero-description", { opacity: 1, y: 0, duration: 0.4 }, "-=0.3")
      .to(".hero-info",        { opacity: 1, y: 0, duration: 0.4 }, "-=0.3")
      .to(".hero-badges",      { opacity: 1, y: 0, duration: 0.4 }, "-=0.3")
      .to(".hero-buttons",     { opacity: 1, y: 0, duration: 0.5 }, "-=0.3");
  });
</script>
