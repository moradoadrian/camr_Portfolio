---
const links = [
  { key: "home", name: "Inicio", href: "#top" },
  { key: "about", name: "Sobre Mí", href: "#about" },
  { key: "experience", name: "Experiencia", href: "#experience" },
  { key: "certifications", name: "Certificaciones", href: "#certifications" },
  { key: "projects", name: "Proyectos", href: "#projects" },
  { key: "contact", name: "Contacto", href: "#contact" },
];
---

<nav
  class="fixed top-0 left-0 w-full z-50 border-b border-slate-800 bg-slate-950/90 backdrop-blur-sm font-mono"
  id="navbar"
>
  <div
    class="max-w-7xl mx-auto flex justify-between items-center px-6 py-4"
  >
    <a
      href="#"
      class="text-lg font-bold text-purple-400 hover:text-purple-300 transition-colors"
      data-i18n="navbar.logo"
    >
      ~/camr_portfolio
    </a>

    <!-- Desktop Menu -->
    <ul class="hidden md:flex gap-8 items-center">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link text-sm text-slate-400 hover:text-purple-400 transition-colors relative group flex items-center gap-1"
            >
              <span class="text-purple-600 opacity-0 group-hover:opacity-100 transition-opacity">></span>
              <span data-i18n={`navbar.${link.key}`}>{link.name}</span>
            </a>
          </li>
        ))
      }
      <!-- Language Selector Desktop -->
      <li class="ml-4">
        <div class="lang-selector font-mono text-xs flex items-center border border-slate-800 bg-slate-900/60 p-0.5 rounded">
          <button 
            id="lang-btn-es" 
            class="px-2 py-1 rounded transition-all duration-300 text-purple-400 font-bold bg-purple-500/10" 
            aria-label="Cambiar idioma a Español"
          >
            ES
          </button>
          <span class="text-slate-700 px-0.5 select-none">|</span>
          <button 
            id="lang-btn-en" 
            class="px-2 py-1 rounded transition-all duration-300 text-slate-500 hover:text-slate-300" 
            aria-label="Switch language to English"
          >
            EN
          </button>
        </div>
      </li>
    </ul>

    <!-- Mobile Lang Selector and Menu Button -->
    <div class="flex items-center gap-4 md:hidden">
      <div class="lang-selector font-mono text-[10px] flex items-center border border-slate-800 bg-slate-900/60 p-0.5 rounded">
        <button 
          id="lang-btn-es-mob" 
          class="px-1.5 py-0.5 rounded transition-all duration-300 text-purple-400 font-bold bg-purple-500/10" 
          aria-label="Cambiar idioma a Español"
        >
          ES
        </button>
        <span class="text-slate-700 px-0.5 select-none">|</span>
        <button 
          id="lang-btn-en-mob" 
          class="px-1.5 py-0.5 rounded transition-all duration-300 text-slate-500 hover:text-slate-300" 
          aria-label="Switch language to English"
        >
          EN
        </button>
      </div>

      <button
        class="text-purple-400 hover:text-purple-300 focus:outline-none border border-slate-700 p-1"
        id="mobile-menu-btn"
      >
        <span class="sr-only">Open menu</span>
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay: kept outside <nav> because the nav's backdrop-filter
     would otherwise become the containing block and clip this fixed layer to the bar's height -->
<div
  class="fixed inset-0 h-[100dvh] z-[95] bg-slate-950 transform translate-x-full invisible transition-[transform,visibility] duration-300 md:hidden flex flex-col font-mono"
  id="mobile-menu"
  aria-hidden="true"
>
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#a855f714_1px,transparent_1px),linear-gradient(to_bottom,#a855f714_1px,transparent_1px)] bg-[size:32px_32px]"></div>
  <div class="pointer-events-none absolute -top-24 -right-24 w-72 h-72 bg-purple-600/20 blur-[100px] rounded-full"></div>

  <div class="relative flex justify-between items-center px-6 py-4 border-b border-slate-800">
    <span class="text-lg font-bold text-purple-400">~/menu</span>
    <button class="text-purple-400 hover:text-purple-300 border border-slate-700 p-1" id="close-menu-btn" aria-label="Close menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div class="relative flex-1 flex flex-col justify-center px-8 gap-2 overflow-y-auto">
    {
      links.map((link, i) => (
        <a
          href={link.href}
          class="nav-link mobile-link group flex items-baseline gap-4 py-3 border-b border-slate-800/70 text-2xl font-bold text-slate-300 hover:text-purple-400 transition-colors"
          style={`--i: ${i}`}
        >
          <span class="text-xs text-purple-500/70 tabular-nums">0{i + 1}</span>
          <span class="text-purple-600 group-hover:translate-x-1 transition-transform">&gt;</span>
          <span data-i18n={`navbar.${link.key}`}>{link.name}</span>
        </a>
      ))
    }
  </div>

  <div class="relative px-8 py-6 border-t border-slate-800 text-xs text-slate-500 flex items-center justify-between">
    <a href="mailto:moradoadrian@gmail.com" class="hover:text-purple-300 transition-colors">moradoadrian@gmail.com</a>
    <span class="text-purple-500">End_of_Line_</span>
  </div>
</div>

<style>
  /* Links slide in one after another when the menu opens */
  #mobile-menu .mobile-link {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.35s ease, transform 0.35s ease, color 0.15s;
  }
  #mobile-menu.is-open .mobile-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 50ms + 120ms), calc(var(--i) * 50ms + 120ms), 0s;
  }
</style>

<script>
  const navbar = document.getElementById("navbar");
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("close-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Scroll effect
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      navbar?.classList.add("bg-slate-950/98", "shadow-[0_4px_30px_rgba(0,0,0,0.8)]", "border-purple-500/20");
      navbar?.classList.remove("bg-slate-950/90");
    } else {
      navbar?.classList.remove("bg-slate-950/98", "shadow-[0_4px_30px_rgba(0,0,0,0.8)]", "border-purple-500/20");
      navbar?.classList.add("bg-slate-950/90");
    }
  });

  // Mobile menu toggle
  const toggleMenu = () => {
    const open = mobileMenu?.classList.toggle("is-open") ?? false;
    mobileMenu?.classList.toggle("translate-x-full", !open);
    mobileMenu?.classList.toggle("invisible", !open);
    mobileMenu?.setAttribute("aria-hidden", String(!open));
    mobileBtn?.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("overflow-hidden", open);
  };

  mobileBtn?.addEventListener("click", toggleMenu);
  closeBtn?.addEventListener("click", toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", toggleMenu);
  });

  // Active Section Tracker using IntersectionObserver
  const sections = document.querySelectorAll("section");
  const navLinks = document.querySelectorAll(".nav-link");

  const observerOptions = {
    root: null,
    rootMargin: "-25% 0px -55% 0px",
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute("id");
        navLinks.forEach((link) => {
          const href = link.getAttribute("href");
          if (href === `#${id}` || (id === "top" && href === "#top")) {
            link.classList.add("text-purple-400", "font-bold");
            link.classList.remove("text-slate-400", "text-slate-300");
          } else {
            link.classList.remove("text-purple-400", "font-bold");
            if (link.classList.contains("mobile-link")) {
              link.classList.add("text-slate-300");
            } else {
              link.classList.add("text-slate-400");
            }
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach((section) => observer.observe(section));
  const bodyTop = document.getElementById("top");
  if (bodyTop) observer.observe(bodyTop);
</script>
