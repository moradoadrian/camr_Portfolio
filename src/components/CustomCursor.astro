---

---

<div
  aria-hidden="true"
  class="custom-cursor fixed top-0 left-0 w-4 h-4 pointer-events-none z-[10001] mix-blend-difference opacity-0 will-change-transform"
>
  <span class="custom-cursor-dot block w-full h-full bg-purple-500 transition-[transform,background-color] duration-150 ease-out"></span>
</div>
<div
  aria-hidden="true"
  class="cursor-follower fixed top-0 left-0 w-8 h-8 pointer-events-none z-[10000] opacity-0 will-change-transform"
>
  <span class="cursor-follower-ring block w-full h-full border-2 border-purple-400 transition-[transform,border-color] duration-200 ease-out"></span>
</div>

<script>
  const canUseCustomCursor =
    window.matchMedia("(pointer: fine)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const cursor = document.querySelector<HTMLElement>(".custom-cursor");
  const follower = document.querySelector<HTMLElement>(".cursor-follower");

  if (canUseCustomCursor && cursor && follower) {
    let mouseX = 0;
    let mouseY = 0;
    let followerX = 0;
    let followerY = 0;
    let visible = false;
    let rafId = 0;

    const show = () => {
      if (visible) return;
      visible = true;
      cursor.style.opacity = "1";
      follower.style.opacity = "1";
      document.documentElement.classList.add("custom-cursor-active");
    };

    const hide = () => {
      if (!visible) return;
      visible = false;
      cursor.style.opacity = "0";
      follower.style.opacity = "0";
      document.documentElement.classList.remove("custom-cursor-active");
    };

    const tick = () => {
      const dx = mouseX - followerX;
      const dy = mouseY - followerY;
      followerX += dx * 0.18;
      followerY += dy * 0.18;

      follower.style.transform = `translate3d(${followerX - 16}px, ${followerY - 16}px, 0)`;

      if (Math.abs(dx) > 0.25 || Math.abs(dy) > 0.25) {
        rafId = requestAnimationFrame(tick);
      } else {
        followerX = mouseX;
        followerY = mouseY;
        follower.style.transform = `translate3d(${followerX - 16}px, ${followerY - 16}px, 0)`;
        rafId = 0;
      }
    };

    window.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!visible) {
        followerX = mouseX;
        followerY = mouseY;
        follower.style.transform = `translate3d(${followerX - 16}px, ${followerY - 16}px, 0)`;
        show();
      }

      cursor.style.transform = `translate3d(${mouseX - 8}px, ${mouseY - 8}px, 0)`;

      if (!rafId) rafId = requestAnimationFrame(tick);
    }, { passive: true });

    document.addEventListener("mouseleave", hide);
    window.addEventListener("blur", hide);

    const interactiveSelector = "a, button, [role='button'], input, textarea, select, label";
    let hovered = false;

    document.addEventListener("mouseover", (e) => {
      const isInteractive = Boolean((e.target as Element | null)?.closest(interactiveSelector));
      if (isInteractive === hovered) return;
      hovered = isInteractive;
      cursor.classList.toggle("is-hover", hovered);
      follower.classList.toggle("is-hover", hovered);
    }, { passive: true });
  }
</script>

<style is:global>
  html.custom-cursor-active,
  html.custom-cursor-active body {
    cursor: none;
  }

  .custom-cursor.is-hover .custom-cursor-dot {
    transform: scale(0.5);
    background-color: #ffffff;
  }

  .cursor-follower.is-hover .cursor-follower-ring {
    transform: scale(1.5) rotate(45deg);
    border-color: #ffffff;
  }
</style>
