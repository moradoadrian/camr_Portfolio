---

---

<div
  aria-hidden="true"
  class="custom-cursor hidden fixed top-0 left-0 w-4 h-4 bg-purple-500 pointer-events-none z-[9999] mix-blend-difference opacity-0 will-change-transform"
>
</div>
<div
  aria-hidden="true"
  class="cursor-follower hidden fixed top-0 left-0 w-8 h-8 border-2 border-purple-400 pointer-events-none z-[9998] opacity-0 will-change-transform"
>
</div>

<script>
  import { gsap } from "gsap";

  const canUseCustomCursor =
    window.matchMedia("(pointer: fine)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const cursor = document.querySelector<HTMLElement>(".custom-cursor");
  const follower = document.querySelector<HTMLElement>(".cursor-follower");

  if (canUseCustomCursor && cursor && follower) {
    cursor.classList.remove("hidden");
    follower.classList.remove("hidden");

    const setCursorX = gsap.quickSetter(cursor, "x", "px");
    const setCursorY = gsap.quickSetter(cursor, "y", "px");
    const setFollowerX = gsap.quickSetter(follower, "x", "px");
    const setFollowerY = gsap.quickSetter(follower, "y", "px");

    let mouseX = 0;
    let mouseY = 0;
    let followerX = 0;
    let followerY = 0;
    let visible = false;
    let rafId = 0;

    // Only animate while the follower is catching up — zero idle CPU usage
    const tick = () => {
      const dx = mouseX - followerX;
      const dy = mouseY - followerY;
      followerX += dx * 0.18;
      followerY += dy * 0.18;

      setFollowerX(followerX - 16);
      setFollowerY(followerY - 16);

      if (Math.abs(dx) > 0.25 || Math.abs(dy) > 0.25) {
        rafId = requestAnimationFrame(tick);
      } else {
        followerX = mouseX;
        followerY = mouseY;
        setFollowerX(followerX - 16);
        setFollowerY(followerY - 16);
        rafId = 0;
      }
    };

    document.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!visible) {
        visible = true;
        followerX = mouseX;
        followerY = mouseY;
        cursor.style.opacity = "1";
        follower.style.opacity = "1";
      }

      setCursorX(mouseX - 8);
      setCursorY(mouseY - 8);

      if (!rafId) rafId = requestAnimationFrame(tick);
    }, { passive: true });

    document.addEventListener("mouseleave", () => {
      visible = false;
      cursor.style.opacity = "0";
      follower.style.opacity = "0";
    });

    // Event delegation so dynamically rendered links/buttons (Terminal, JobMatch) work too
    const interactiveSelector = "a, button, [role='button'], input, textarea, select, label";
    let hovered = false;

    document.addEventListener("mouseover", (e) => {
      const isInteractive = Boolean((e.target as Element | null)?.closest(interactiveSelector));
      if (isInteractive === hovered) return;
      hovered = isInteractive;
      if (hovered) {
        gsap.to(cursor, { scale: 0.5, backgroundColor: "#fff", duration: 0.18, overwrite: "auto" });
        gsap.to(follower, { scale: 1.5, borderColor: "#fff", rotation: 45, duration: 0.25, overwrite: "auto" });
      } else {
        gsap.to(cursor, { scale: 1, backgroundColor: "#a855f7", duration: 0.18, overwrite: "auto" });
        gsap.to(follower, { scale: 1, borderColor: "#c084fc", rotation: 0, duration: 0.25, overwrite: "auto" });
      }
    }, { passive: true });
  }
</script>

<style is:global>
  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    body {
      cursor: none;
    }
  }
</style>
