---
import {
  siAngular,
  siTypescript,
  siTailwindcss,
  siPython,
  siFastapi,
  siFirebase,
  siMysql,
  siPostgresql,
  siSupabase,
  siDotnet,
  siCapacitor,
  siMaterialdesign,
  siPwa,
  siAstro,
  siVercel,
  siNetlify,
} from "simple-icons";

// Official Simple Icons marks, same approach as Technologies.astro. Brands whose
// official hex is too dark for this site's slate cards get a light override.
function brandIcon(icon: { title: string; path: string; hex: string }, fillOverride?: string) {
  const fill = fillOverride ?? `#${icon.hex}`;
  return `<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="${icon.path}" fill="${fill}"/></svg>`;
}

const techIcons: Record<string, string> = {
  Angular: brandIcon(siAngular, "#E23237"),
  TypeScript: brandIcon(siTypescript),
  Tailwind: brandIcon(siTailwindcss),
  Python: brandIcon(siPython),
  FastAPI: brandIcon(siFastapi),
  Firebase: brandIcon(siFirebase),
  MySQL: brandIcon(siMysql, "#4DB6E8"),
  PostgreSQL: brandIcon(siPostgresql, "#6E9FD6"),
  Supabase: brandIcon(siSupabase),
  ".NET": brandIcon(siDotnet, "#A77BFF"),
  Capacitor: brandIcon(siCapacitor),
  "Material Design": brandIcon(siMaterialdesign, "#E2E8F0"),
  PWA: brandIcon(siPwa, "#A78BFA"),
  Astro: brandIcon(siAstro),
  Vercel: brandIcon(siVercel, "#E2E8F0"),
  Netlify: brandIcon(siNetlify),
  "SHA-256": `<svg class="w-3.5 h-3.5 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
};

const getTechIcon = (tag: string) => {
  return techIcons[tag] || `<svg class="w-3.5 h-3.5 shrink-0 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>`;
};

// Main featured project (Full Width on desktop)
const featuredProject = {
  key: "surticel",
  title: "Surticel",
  subtitle: "Plataforma de pedidos B2B · Fruta y verdura",
  url: "https://surticel.com",
  domain: "surticel.com",
  overview: "Plataforma de pedidos en línea para un surtidor de fruta y verdura en Celaya. Los negocios clientes consultan el catálogo con precios y existencias actualizados, arman su pedido en minutos y dan seguimiento a la entrega hasta su puerta.",
  problem: "Los pedidos de los negocios clientes se tomaban por teléfono o mensaje, sin visibilidad de precios, existencias ni del estado de la entrega.",
  challenge: "Construir una experiencia rápida y confiable en celular para clientes que piden en plena operación, con el catálogo siempre al día y avisos del estado de cada pedido.",
  solution: "PWA instalable con catálogo por categorías, carrito, historial y seguimiento de pedidos, notificaciones Web Push y tema claro/oscuro.",
  architecture: "SPA en Angular con Tailwind CSS; Supabase como backend (autenticación y base de datos PostgreSQL) y service worker para instalación y notificaciones push.",
  role: "Full-Stack Developer — Diseño y desarrollo de la plataforma de punta a punta: interfaz, modelo de datos, autenticación y despliegue.",
  results: [
    "Catálogo con precio y stock siempre actualizados",
    "Seguimiento del pedido desde la confirmación hasta la entrega",
    "App instalable (PWA) con notificaciones push",
    "Carga optimizada: imágenes AVIF y precarga del hero",
  ],
  highlights: [
    { icon: "📱", key: "pwa", label: "PWA instalable" },
    { icon: "🔔", key: "push", label: "Web Push" },
    { icon: "🌗", key: "theme", label: "Modo oscuro" },
    { icon: "🔐", key: "auth", label: "Auth Supabase" },
  ],
  tags: ["Angular", "TypeScript", "Supabase", "PostgreSQL", "Tailwind", "PWA"],
  image: "/surticel-full.png",
};

// Other prominent projects (Grid cards)
const generalProjects = [
  {
    key: "celebraya",
    title: "Celebra-Ya Studio",
    domain: "celebra-ya.com",
    overview: "Estudio de invitaciones digitales a la medida para bodas, XV años, bautizos y eventos especiales: sitio comercial con portafolio filtrable por tipo de evento, paquetes con precios y solicitud de cotización.",
    problem: "Las invitaciones impresas o en imagen no permiten confirmar asistencia, ubicar el evento ni controlar el acceso de los invitados.",
    solution: "Invitaciones web con cuenta regresiva, mapa a Google Maps y Waze, RSVP por WhatsApp, galería HD y pases QR individuales, más un sitio de venta con catálogo y paquetes.",
    role: "Fundador y desarrollador — Diseño, desarrollo y despliegue del sitio del estudio y de cada invitación.",
    metrics: "Entregas de 48 horas a 7 días. Pases QR para eventos de hasta 250 invitados.",
    tags: ["Astro", "Tailwind", "Vercel"],
    image: "/celebraya-full.jpg",
    scroll: true,
    // Long landing page (7000px): slower pan so it stays readable
    scrollMs: 12000,
    links: [
      { nameKey: "live", url: "https://celebra-ya.com" },
      { nameKey: "portafolio", url: "https://celebra-ya.com/plantillas" }
    ]
  },
  {
    key: "constancias",
    title: "Constancias de Inexistencia",
    overview: "Emisión y gestión de actas de inexistencia para la Dirección General del Registro Civil. Digitaliza trámites administrativos gubernamentales clave, agilizando el servicio al ciudadano mediante validación criptográfica y firmas digitales.",
    problem: "Los procesos de búsqueda y emisión de constancias tardaban entre 10 y 15 días hábiles debido al procesamiento manual y archivos heredados fragmentados.",
    solution: "Plataforma web con búsqueda indexada rápida, formularios inteligentes y un validador de integridad documental basado en hash SHA-256.",
    role: "Lead Full-Stack Developer — Responsable de la arquitectura frontend en Angular 17, diseño de la base de datos y flujos de carga segura de archivos.",
    metrics: "Reducción del tiempo de trámite de 15 días a menos de 5 minutos.",
    metricsKey: "metric1",
    tags: ["Angular", "Python", "FastAPI", "Material Design", "SHA-256"],
    image: "/constanciasI.png",
    links: []
  },
  {
    key: "logpath",
    title: "LogPath (midudev Hackathon)",
    overview: "Arquitectura de telemetría Edge-to-Cloud para puntos de venta (POS). Audita transacciones en tiempo real con interceptor de fallas.",
    problem: "Falta de visibilidad e imposibilidad de diagnosticar problemas en terminales de pago remotas antes de recibir quejas del cliente.",
    solution: "Agente en .NET 10 y panel web Angular 19 para monitorear eventos críticos en tiempo real y enviar alertas automáticas vía Discord Webhooks.",
    role: "Full-Stack Developer — Diseñé la interfaz del dashboard reactivo y conecté los flujos de telemetría en tiempo real.",
    metrics: "Latencia de alerta de eventos < 150ms. Telemetría de red automatizada.",
    tags: ["Angular", ".NET", "MySQL", "Tailwind"],
    image: "/logpath.png",
    links: [
      { nameKey: "demo", url: "http://logpath-web-9vvsqy-78a8c8-108-165-47-114.traefik.me" },
      { nameKey: "repoFront", url: "https://github.com/moradoadrian/LogPath" },
      { nameKey: "repoAPI", url: "https://github.com/moradoadrian/logpath-api" }
    ]
  },
  {
    key: "anotaciones",
    title: "Anotaciones Judiciales",
    overview: "Plataforma digital para la Dirección General del Registro Civil para asentar y auditar anotaciones marginales y rectificaciones legales.",
    problem: "Anotaciones en actas manuales propensas a errores de transcripción, pérdida física y demoras de búsqueda en libros físicos.",
    solution: "Base de datos transaccional con control de auditoría estricto, flujos de aprobación y paneles de búsqueda rápida.",
    role: "Lead Frontend Developer — Implementé la interfaz web completa, control de accesos por roles y el sistema de impresión de sellos.",
    metrics: "Más de 10,000 registros indexados y digitalizados. Control de errores al 0%.",
    tags: ["Angular", "Tailwind", "MySQL", "Firebase"],
    image: "/anotacionesJ.png",
    links: [
      { nameKey: "repo", url: "https://github.com/moradoadrian/" }
    ]
  },
  {
    key: "posmiche",
    title: "POS Miche LTS",
    overview: "Punto de venta y control de inventarios multiplataforma de alta velocidad para dispositivos móviles y escritorio.",
    problem: "Puntos de venta convencionales lentos, incompatibles con tabletas Android y dependientes de conectividad continua.",
    solution: "Aplicación híbrida responsiva con sincronización en segundo plano de base de datos local y Firebase.",
    role: "Mobile & Frontend Developer — Diseñé la UI móvil y la compilación híbrida utilizando Capacitor.",
    metrics: "Más de 5,000 transacciones mensuales procesadas sin interrupciones.",
    tags: ["Angular", "Firebase", "Capacitor", "Tailwind"],
    image: "/posMiche.png",
    links: []
  },
  {
    key: "purplewings",
    title: "Purple Wings",
    domain: "purple-wings.netlify.app",
    overview: "App de pedidos en línea para un negocio de alitas adobadas al carbón en Celaya, con identidad visual propia y flujo de compra pensado para celular.",
    problem: "Los pedidos llegaban por mensajes sueltos sin cantidades, total ni datos de entrega claros, lo que generaba errores y vueltas de confirmación.",
    solution: "Selector de paquetes con cálculo de total en vivo, formulario de entrega y envío del pedido ya armado por WhatsApp, más enlace y código QR para compartir.",
    role: "Frontend Developer — Diseñé la identidad visual de la app y desarrollé el flujo de pedido en Angular.",
    metrics: "Pedido completo en un solo mensaje de WhatsApp, listo en ~15–20 minutos.",
    tags: ["Angular", "TypeScript", "Netlify"],
    image: "/purpleW-full.png",
    scroll: true,
    links: [
      { nameKey: "live", url: "https://purple-wings.netlify.app/#/inicio" }
    ]
  }
];

const caseStudyRows = [
  { label: "problemLabel", fallback: "Problema:", field: "problem" },
  { label: "challengeLabel", fallback: "Desafío:", field: "challenge" },
  { label: "solutionLabel", fallback: "Solución:", field: "solution" },
  { label: "architectureLabel", fallback: "Arquitectura:", field: "architecture" },
  { label: "roleLabel", fallback: "Rol:", field: "role" },
] as const;
---

<section id="projects" class="py-24 px-4 relative bg-slate-900/10 border-t border-slate-900 overflow-hidden">
  <!-- Ambient glow behind the featured card -->
  <div class="pointer-events-none absolute top-40 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-purple-600/10 blur-[120px] rounded-full"></div>

  <div class="max-w-6xl mx-auto relative">
    <div class="text-center mb-20">
      <h2 class="text-2xl sm:text-4xl md:text-5xl text-balance font-bold font-pixel text-purple-400 mb-4 tracking-wider" data-i18n="proj.title">
        &lt;Proyectos_Destacados /&gt;
      </h2>
      <p class="font-mono text-xs text-slate-500 max-w-md mx-auto" data-i18n="proj.subtitle">
        // PORTAFOLIO DE PROYECTOS Y SISTEMAS DE PRODUCCIÓN
      </p>
    </div>

    <!-- Featured (Highlighted) Case Study Card - Full Width on desktop -->
    <div class="project-featured-card group relative rounded-md mb-16 opacity-0 translate-y-10 p-[2px] bg-gradient-to-br from-purple-500/70 via-slate-800 to-emerald-500/60 shadow-[0_0_40px_rgba(168,85,247,0.15)] hover:shadow-[0_0_60px_rgba(168,85,247,0.25)] transition-shadow duration-500">
      <div class="relative bg-slate-950 rounded-[5px] p-6 md:p-8">
        <div class="absolute top-0 left-0 flex items-stretch font-mono text-[10px] tracking-widest uppercase font-bold">
          <span class="bg-purple-600 text-white px-3 py-1 rounded-br-md" data-i18n="proj.featuredLabel">SISTEMA_DESTACADO_PRINCIPAL</span>
        </div>
        <div class="absolute top-9 left-6 sm:top-3 sm:left-auto sm:right-4 flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase text-emerald-400 font-bold">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span data-i18n="proj.liveLabel">EN_PRODUCCIÓN</span>
        </div>

        <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-start mt-12 sm:mt-6">
          <!-- Browser mockup with scroll-on-hover screenshot -->
          <div class="lg:col-span-6 lg:sticky lg:top-24">
            <a
              href={featuredProject.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-lg overflow-hidden border border-slate-700 bg-slate-900 shadow-2xl shadow-black/60 transition-transform duration-500 group-hover:-translate-y-1"
              aria-label={`Visitar ${featuredProject.domain}`}
            >
              <div class="flex items-center gap-3 px-3 py-2 bg-slate-900 border-b border-slate-800">
                <div class="flex gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
                </div>
                <div class="flex-1 flex items-center gap-1.5 bg-slate-950 border border-slate-800 rounded px-2.5 py-1 font-mono text-[10px] text-slate-400 min-w-0">
                  <svg class="w-3 h-3 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                  <span class="truncate">https://<span class="text-slate-200">{featuredProject.domain}</span></span>
                </div>
                <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-purple-400 transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </div>
              <div class="relative aspect-[16/10] overflow-hidden bg-slate-950">
                <img
                  src={featuredProject.image}
                  alt={`Captura de ${featuredProject.domain}`}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover object-top group-hover:object-bottom transition-[object-position] duration-[5000ms] ease-in-out"
                />
                <div class="absolute bottom-2 right-2 font-mono text-[9px] uppercase tracking-widest bg-slate-950/80 text-slate-400 px-2 py-1 rounded border border-slate-800 opacity-100 group-hover:opacity-0 transition-opacity" data-i18n="proj.hoverHint">
                  ↓ hover para recorrer
                </div>
              </div>
            </a>

            <!-- Highlight chips -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4 font-mono">
              {featuredProject.highlights.map((h) => (
                <div class="flex items-center gap-2 bg-slate-900/70 border border-slate-800 rounded px-2.5 py-2 text-[10px] text-slate-300 hover:border-emerald-500/40 transition-colors">
                  <span class="text-sm leading-none">{h.icon}</span>
                  <span data-i18n={`proj.${featuredProject.key}.hl.${h.key}`}>{h.label}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Project Details / Case Study layout -->
          <div class="lg:col-span-6 font-mono flex flex-col h-full">
            <p class="text-[10px] uppercase tracking-[0.2em] text-emerald-400 mb-2" data-i18n={`proj.${featuredProject.key}.subtitle`}>
              {featuredProject.subtitle}
            </p>
            <h3 class="text-3xl font-bold text-white mb-3 font-pixel tracking-wide group-hover:text-purple-400 transition-colors">
              {featuredProject.title}
            </h3>

            <p class="text-sm text-slate-300 leading-relaxed mb-6" data-i18n={`proj.${featuredProject.key}.overview`}>
              {featuredProject.overview}
            </p>

            <div class="border-t border-slate-800/80 pt-4 space-y-3 text-xs">
              {caseStudyRows.map((row) => (
                <div class="grid sm:grid-cols-12 gap-1 sm:gap-2">
                  <span class="sm:col-span-3 text-purple-400 font-bold uppercase tracking-wider" data-i18n={`proj.${row.label}`}>{row.fallback}</span>
                  <span class="sm:col-span-9 text-slate-400 leading-relaxed" data-i18n={`proj.${featuredProject.key}.${row.field}`}>{featuredProject[row.field]}</span>
                </div>
              ))}

              <div class="border-t border-slate-900/60 pt-4 mt-2">
                <h4 class="text-purple-400 font-bold uppercase tracking-wider mb-3" data-i18n="proj.resultsLabel">Resultados:</h4>
                <ul class="grid sm:grid-cols-2 gap-2 text-slate-300">
                  {featuredProject.results.map((result, i) => (
                    <li class="flex items-start gap-2 bg-slate-900/50 border border-slate-800/80 rounded px-3 py-2">
                      <span class="text-emerald-400 font-bold">✓</span>
                      <span class="text-[11px] leading-snug" data-i18n={`proj.${featuredProject.key}.result${i + 1}`}>{result}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Bottom: Tech Stack & CTA -->
            <div class="mt-6 pt-4 border-t border-slate-800 flex flex-col gap-5">
              <div class="flex flex-wrap gap-2">
                {featuredProject.tags.map((tag) => (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-900 border border-slate-800 text-[10px] text-slate-300 rounded font-semibold hover:border-purple-500/40 hover:-translate-y-0.5 transition-all cursor-default" title={tag}>
                    <Fragment set:html={getTechIcon(tag)} />
                    {tag}
                  </span>
                ))}
              </div>

              <a
                href={featuredProject.url}
                target="_blank"
                rel="noopener noreferrer"
                class="self-start inline-flex items-center gap-2 px-5 py-2.5 bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold tracking-wider transition-all hover:-translate-y-0.5 hover:shadow-[0_0_20px_rgba(168,85,247,0.45)]"
              >
                <span data-i18n="proj.visitSite">[ VISITAR_SITIO ]</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Corner Accents -->
        <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-slate-700 group-hover:border-purple-500 transition-colors"></div>
      </div>
    </div>

    <!-- Other Prominent Projects Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {
        generalProjects.map((project) => (
          <div class="project-card group relative bg-slate-950 border-2 border-slate-800 hover:border-purple-500/80 transition-all duration-300 hover:shadow-[0_0_25px_rgba(168,85,247,0.12)] p-6 rounded-md flex flex-col justify-between opacity-0 translate-y-10 md:[&:last-child:nth-child(odd)]:col-span-2 md:[&:last-child:nth-child(odd)]:w-full md:[&:last-child:nth-child(odd)]:max-w-[calc(50%-1rem)] md:[&:last-child:nth-child(odd)]:mx-auto">

            <div>
              <!-- Mini browser frame -->
              <div class="overflow-hidden border border-slate-800 rounded mb-5 bg-slate-900">
                <div class="flex items-center gap-1 px-2.5 py-1.5 border-b border-slate-800 bg-slate-900">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-600 group-hover:bg-red-500/80 transition-colors"></span>
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-600 group-hover:bg-yellow-500/80 transition-colors"></span>
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-600 group-hover:bg-green-500/80 transition-colors"></span>
                  <span class="ml-2 font-mono text-[9px] text-slate-500 truncate">{project.domain ?? `~/${project.key}`}</span>
                </div>
                <div class="aspect-video overflow-hidden relative">
                  <img
                    src={project.image}
                    alt={project.title}
                    loading="lazy"
                    class={project.scroll
                      ? "absolute inset-0 w-full h-full object-cover object-top group-hover:object-bottom transition-[object-position] duration-[4000ms] ease-in-out"
                      : "w-full h-full object-cover object-top transform group-hover:scale-105 transition-transform duration-700"}
                    style={project.scrollMs ? `transition-duration: ${project.scrollMs}ms` : undefined}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent group-hover:from-slate-950/20 transition-colors duration-300"></div>
                  {project.scroll && (
                    <div class="absolute bottom-2 right-2 font-mono text-[9px] uppercase tracking-widest bg-slate-950/80 text-slate-400 px-2 py-1 rounded border border-slate-800 group-hover:opacity-0 transition-opacity" data-i18n="proj.hoverHint">
                      ↓ hover para recorrer
                    </div>
                  )}
                </div>
              </div>

              <div class="font-mono">
                <h3 class="text-xl font-bold text-white mb-2 font-pixel tracking-wide group-hover:text-purple-400 transition-colors">
                  {project.title}
                </h3>
                <p class="text-xs text-slate-400 leading-relaxed mb-5" data-i18n={`proj.${project.key}.overview`}>
                  {project.overview}
                </p>

                <div class="space-y-3 text-[11px] text-slate-500 border-l-2 border-slate-800 group-hover:border-purple-500/50 transition-colors pl-3 mb-5">
                  <p>
                    <span class="text-purple-400 font-bold uppercase tracking-wider" data-i18n="proj.problemLabel">Problema:</span> <span class="text-slate-400" data-i18n={`proj.${project.key}.problem`}>{project.problem}</span>
                  </p>
                  <p>
                    <span class="text-purple-400 font-bold uppercase tracking-wider" data-i18n="proj.solutionLabel">Solución:</span> <span class="text-slate-400" data-i18n={`proj.${project.key}.solution`}>{project.solution}</span>
                  </p>
                  <p>
                    <span class="text-purple-400 font-bold uppercase tracking-wider" data-i18n="proj.roleLabel">Rol:</span> <span class="text-slate-400" data-i18n={`proj.${project.key}.role`}>{project.role}</span>
                  </p>
                </div>

                <div class="flex items-start gap-2 bg-emerald-500/5 border border-emerald-500/20 rounded px-3 py-2 text-[11px] text-emerald-300/90">
                  <span>⚡</span>
                  <span data-i18n={`proj.${project.key}.${project.metricsKey ?? "metrics"}`}>{project.metrics}</span>
                </div>
              </div>
            </div>

            <div class="font-mono mt-5 pt-4 border-t border-slate-800/80 flex flex-col gap-4">
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-slate-900 border border-slate-800 text-[9px] text-slate-400 rounded hover:border-purple-500/30 transition-colors cursor-default" title={tag}>
                    <Fragment set:html={getTechIcon(tag)} />
                    {tag}
                  </span>
                ))}
              </div>

              {project.links.length > 0 && (
                <div class="flex flex-wrap gap-3">
                  {project.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[10px] text-purple-400 hover:text-purple-300 font-bold uppercase hover:underline underline-offset-4"
                    >
                      [{link.nameKey.toUpperCase()}] ↗
                    </a>
                  ))}
                </div>
              )}
            </div>

            <!-- Corner Accents -->
            <div class="absolute top-0 right-0 w-2.5 h-2.5 border-t-2 border-r-2 border-slate-800 group-hover:border-purple-500 transition-colors"></div>
            <div class="absolute bottom-0 left-0 w-2.5 h-2.5 border-b-2 border-l-2 border-slate-800 group-hover:border-purple-500 transition-colors"></div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Fade in & Slide Up scroll reveal
  gsap.to(".project-featured-card", {
    scrollTrigger: {
      trigger: ".project-featured-card",
      start: "top bottom-=80",
      toggleActions: "play none none reverse",
    },
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power3.out"
  });

  const cards = document.querySelectorAll(".project-card");
  cards.forEach((card, i) => {
    gsap.to(card, {
      scrollTrigger: {
        trigger: card,
        start: "top bottom-=80",
        toggleActions: "play none none reverse",
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      delay: (i % 2) * 0.12,
      ease: "power3.out"
    });
  });
</script>
