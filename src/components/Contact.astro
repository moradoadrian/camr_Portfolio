---
// Web3Forms access key (https://web3forms.com). It is public by design: it only lets the form
// deliver to the inbox it was created for. While it is empty, the form falls back to opening
// the visitor's email app with the message already written.
const WEB3FORMS_KEY = "c32732b3-7e48-4ca1-b20d-c76fadb0af3c";
const EMAIL = "moradoadrian@gmail.com";

const reasons = [
  { value: "job", key: "contact.form.reasonJob", label: "Vacante" },
  { value: "freelance", key: "contact.form.reasonFreelance", label: "Proyecto freelance" },
  { value: "other", key: "contact.form.reasonOther", label: "Otro" },
];
const MESSAGE_MIN = 20;
const MESSAGE_MAX = 1000;
---

<section
  id="contact"
  class="py-24 px-4 relative overflow-hidden border-t border-slate-900 bg-slate-950/20"
>
  <div class="max-w-6xl mx-auto relative z-10 font-mono">
    <div class="text-center">
      <h2 class="text-2xl sm:text-4xl md:text-5xl text-balance font-bold mb-8 font-pixel text-purple-400" data-i18n="contact.title">
        &lt;Initialize_Connection /&gt;
      </h2>

      <p class="text-base md:text-lg text-slate-400 mb-12 max-w-2xl mx-auto">
        <span data-i18n="contact.subtitle">// Estoy siempre abierto a nuevas oportunidades y colaboraciones técnicas.</span>
        <br />
        <span class="text-purple-500">if</span> (project.isInteresting || role.isSenior) <span
          class="text-purple-500"
          >&#123;
          <br />
          &nbsp;&nbsp;establishSecureConnection();
          <br />
          &#125;</span>
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8 text-left items-start">
      <!-- Contact form -->
      <form
        id="contact-form"
        class="lg:col-span-3 bg-slate-950 border-2 border-slate-800 focus-within:border-purple-500/60 transition-colors rounded-md overflow-hidden shadow-2xl"
        data-key={WEB3FORMS_KEY}
        data-email={EMAIL}
        data-min={MESSAGE_MIN}
        novalidate
      >
        <div class="bg-slate-900 px-4 py-2.5 flex items-center gap-2 border-b border-slate-800">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
          <span class="ml-2 text-xs text-slate-500">send_message.sh</span>
        </div>

        <div class="p-5 md:p-7 space-y-5">
          <div>
            <p class="text-sm text-white font-bold"><span class="text-purple-500">$</span> send_message --to cesar</p>
            <p class="mt-1 text-xs text-slate-500" data-i18n="contact.form.intro">// ¿Tienes una vacante o un proyecto? Escríbeme y te respondo a tu correo.</p>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="cf-name" class="block text-[11px] uppercase tracking-widest text-purple-400 mb-1.5">
                &gt; <span data-i18n="contact.form.name">Nombre</span>
              </label>
              <input
                id="cf-name"
                name="name"
                type="text"
                autocomplete="name"
                maxlength="80"
                required
                aria-describedby="cf-name-error"
                data-i18n-placeholder="contact.form.namePh"
                placeholder="Tu nombre"
                class="cf-input"
              />
              <p id="cf-name-error" class="cf-error hidden" data-i18n="contact.form.errName">Escribe tu nombre.</p>
            </div>
            <div>
              <label for="cf-email" class="block text-[11px] uppercase tracking-widest text-purple-400 mb-1.5">
                &gt; <span data-i18n="contact.form.email">Correo</span>
              </label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                maxlength="120"
                required
                aria-describedby="cf-email-error"
                data-i18n-placeholder="contact.form.emailPh"
                placeholder="tu@correo.com"
                class="cf-input"
              />
              <p id="cf-email-error" class="cf-error hidden" data-i18n="contact.form.errEmail">Escribe un correo válido.</p>
            </div>
          </div>

          <fieldset>
            <legend class="text-[11px] uppercase tracking-widest text-purple-400 mb-2">
              &gt; <span data-i18n="contact.form.reason">Motivo</span>
            </legend>
            <div class="flex flex-wrap gap-2">
              {reasons.map((r, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="reason" value={r.value} checked={i === 0} class="peer sr-only" />
                  <span
                    class="inline-block px-3 py-1.5 text-xs border border-slate-700 text-slate-400 rounded transition-colors hover:border-purple-500/60 peer-checked:border-purple-500 peer-checked:bg-purple-500/15 peer-checked:text-purple-200 peer-focus-visible:ring-2 peer-focus-visible:ring-purple-400"
                    data-i18n={r.key}
                  >{r.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <div class="flex items-baseline justify-between mb-1.5">
              <label for="cf-message" class="block text-[11px] uppercase tracking-widest text-purple-400">
                &gt; <span data-i18n="contact.form.message">Mensaje</span>
              </label>
              <span id="cf-count" class="text-[10px] text-slate-600 tabular-nums" aria-hidden="true">0/{MESSAGE_MAX}</span>
            </div>
            <textarea
              id="cf-message"
              name="message"
              rows="6"
              maxlength={MESSAGE_MAX}
              required
              aria-describedby="cf-message-error"
              data-i18n-placeholder="contact.form.messagePh"
              placeholder="Cuéntame sobre el puesto o el proyecto..."
              class="cf-input resize-y min-h-[140px]"
            ></textarea>
            <p id="cf-message-error" class="cf-error hidden" data-i18n="contact.form.errMessage">El mensaje debe tener al menos 20 caracteres.</p>
          </div>

          <!-- Honeypot: people never see it, bots fill it in and Web3Forms drops the submission -->
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-1">
            <button
              id="cf-submit"
              type="submit"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-purple-600 hover:bg-purple-500 disabled:opacity-60 disabled:cursor-wait text-white font-pixel text-lg transition-all hover:-translate-y-0.5 hover:shadow-[0_0_30px_rgba(168,85,247,0.45)] disabled:hover:translate-y-0 disabled:hover:shadow-none"
            >
              <svg id="cf-spinner" class="hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"></circle><path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
              <span id="cf-label-idle" data-i18n="contact.form.send">[ ENVIAR_MENSAJE ]</span>
              <span id="cf-label-sending" class="hidden" data-i18n="contact.form.sending">ENVIANDO...</span>
            </button>
            <p class="text-[11px] text-slate-500" data-i18n="contact.form.privacy">Tu correo solo se usa para responderte.</p>
          </div>

          <!-- Result messages (one visible at a time) -->
          <div role="status" aria-live="polite" class="text-xs">
            <p data-status="success" class="hidden px-3 py-2.5 rounded border border-emerald-500/40 bg-emerald-500/10 text-emerald-300" data-i18n="contact.form.success">✓ Mensaje enviado. Te responderé a tu correo lo antes posible.</p>
            <p data-status="fallback" class="hidden px-3 py-2.5 rounded border border-purple-500/40 bg-purple-500/10 text-purple-200" data-i18n="contact.form.fallback">Se abrió tu app de correo con el mensaje listo para enviar.</p>
            <p data-status="cooldown" class="hidden px-3 py-2.5 rounded border border-yellow-500/40 bg-yellow-500/10 text-yellow-200" data-i18n="contact.form.cooldown">Ya recibí tu mensaje. Espera un minuto antes de enviar otro.</p>
            <div data-status="error" class="hidden px-3 py-2.5 rounded border border-red-500/40 bg-red-500/10 text-red-300">
              <span data-i18n="contact.form.error">✗ No se pudo enviar el mensaje.</span>
              <a id="cf-mailto" href={`mailto:${EMAIL}`} class="ml-1 underline underline-offset-2 text-red-200 hover:text-white" data-i18n="contact.form.errorAlt">Envíalo por correo</a>
            </div>
          </div>
        </div>
      </form>

      <!-- Direct channels -->
      <div class="lg:col-span-2">
        <p class="text-xs text-slate-500 mb-4" data-i18n="contact.linksTitle">// o por otro canal</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">

          <!-- Email Card -->
          <div class="group relative p-4 bg-slate-950 border-2 border-slate-800 hover:border-purple-500 transition-all duration-300 flex items-center gap-4 rounded-md">
            <a
              href={`mailto:${EMAIL}`}
              class="flex items-center gap-4 w-full"
            >
              <div class="p-2.5 bg-slate-900 group-hover:bg-purple-900/40 transition-colors border border-slate-700 rounded">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-[9px] text-slate-500 group-hover:text-purple-400 tracking-widest uppercase" data-i18n="contact.emailService">EMAIL_SERVICE</p>
                <p class="text-xs text-white font-bold group-hover:text-purple-300 truncate">{EMAIL}</p>
              </div>
            </a>
            <!-- Copy Button -->
            <button
              class="copy-btn absolute top-3 right-3 text-slate-600 hover:text-purple-400 transition-colors cursor-pointer"
              data-copy={EMAIL}
              aria-label="Copiar correo electrónico"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
              </svg>
            </button>
          </div>

          <!-- WhatsApp Card -->
          <div class="group relative p-4 bg-slate-950 border-2 border-slate-800 hover:border-emerald-500 transition-all duration-300 flex items-center gap-4 rounded-md">
            <a
              href="https://wa.me/524614210058"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 w-full"
            >
              <div class="p-2.5 bg-slate-900 group-hover:bg-emerald-950/40 transition-colors border border-slate-700 rounded">
                <svg class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.5-5.739-1.451L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.42 9.863-9.864.001-2.637-1.03-5.115-2.903-6.99-1.872-1.873-4.347-2.907-6.98-2.907-5.442 0-9.87 4.42-9.872 9.863-.001 1.758.465 3.475 1.353 4.996l-.995 3.637 3.709-.972zm12.56-6.666c-.302-.152-1.785-.882-2.057-.982-.273-.099-.471-.148-.669.149-.197.297-.767.967-.94 1.165-.173.199-.347.223-.649.071-.302-.151-1.272-.469-2.423-1.496-.895-.798-1.5-1.784-1.675-2.086-.173-.302-.018-.465.132-.615.136-.135.302-.35.454-.526.151-.175.201-.3.302-.501.101-.201.05-.378-.026-.528-.075-.151-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.785-.73 2.034-1.433.248-.703.248-1.306.173-1.432-.074-.128-.272-.203-.574-.355z"></path>
                </svg>
              </div>
              <div>
                <p class="text-[9px] text-slate-500 group-hover:text-emerald-400 tracking-widest uppercase" data-i18n="contact.instantMsg">INSTANT_MSG</p>
                <p class="text-xs text-white font-bold group-hover:text-emerald-300" data-i18n="contact.whatsapp">WhatsApp Me</p>
              </div>
            </a>
            <!-- Copy Button -->
            <button
              class="copy-btn absolute top-3 right-3 text-slate-600 hover:text-emerald-400 transition-colors cursor-pointer"
              data-copy="+524614210058"
              aria-label="Copiar teléfono"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
              </svg>
            </button>
          </div>

          <!-- LinkedIn Card -->
          <a
            href="https://www.linkedin.com/in/moradoadrian/"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative p-4 bg-slate-950 border-2 border-slate-800 hover:border-blue-500 transition-all duration-300 flex items-center gap-4 rounded-md"
          >
            <div class="p-2.5 bg-slate-900 group-hover:bg-blue-900/40 transition-colors border border-slate-700 rounded">
              <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
              </svg>
            </div>
            <div>
              <p class="text-[9px] text-slate-500 group-hover:text-blue-400 tracking-widest uppercase" data-i18n="contact.profNet">PROFESSIONAL_NET</p>
              <p class="text-xs text-white font-bold group-hover:text-blue-300">linkedin/moradoadrian</p>
            </div>
          </a>

          <!-- GitHub Card -->
          <a
            href="https://github.com/moradoadrian/"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative p-4 bg-slate-950 border-2 border-slate-800 hover:border-slate-400 transition-all duration-300 flex items-center gap-4 rounded-md"
          >
            <div class="p-2.5 bg-slate-900 group-hover:bg-slate-800 transition-colors border border-slate-700 rounded">
              <svg class="w-5 h-5 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
            </div>
            <div>
              <p class="text-[9px] text-slate-500 group-hover:text-slate-400 tracking-widest uppercase" data-i18n="contact.codeRepos">CODE_REPOS</p>
              <p class="text-xs text-white font-bold group-hover:text-slate-300">github/moradoadrian</p>
            </div>
          </a>

          <!-- Download CV Card -->
          <a
            href="/Ing-Cesar-Adrian-Morado-Rodriguez-2026.pdf"
            target="_blank"
            class="group relative p-4 bg-slate-950 hover:bg-slate-900 border-2 border-slate-800 hover:border-purple-500 transition-all duration-300 flex items-center gap-4 rounded-md"
          >
            <div class="p-2.5 bg-slate-900 group-hover:bg-purple-900/40 transition-colors border border-slate-700 rounded">
              <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <div>
              <p class="text-[9px] text-slate-500 group-hover:text-purple-400 tracking-widest uppercase" data-i18n="contact.documentPull">DOWNLOAD_CV</p>
              <p class="text-xs text-white font-bold group-hover:text-purple-300">Get_CV.pdf</p>
            </div>
          </a>

          <!-- Location Card -->
          <div
            class="group relative p-4 bg-slate-950 border-2 border-slate-800 flex items-center gap-4 rounded-md"
          >
            <div class="p-2.5 bg-slate-900 border border-slate-700 rounded">
              <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <p class="text-[9px] text-slate-500 tracking-widest uppercase" data-i18n="contact.geoCoordinates">GEO_COORDINATES</p>
              <p class="text-xs text-white font-bold">Guanajuato, México</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification element -->
  <div
    id="toast"
    class="fixed bottom-6 right-6 z-[110] bg-slate-900 border-2 border-purple-500 px-4 py-3 rounded shadow-[0_0_20px_rgba(168,85,247,0.2)] flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 font-mono text-xs text-purple-300 hidden"
  >
    <span class="font-bold select-none text-purple-400">[i] COP_SUCCESS:</span>
    <span id="toast-message">Copied to clipboard!</span>
  </div>
</section>

<style>
  .cf-input {
    @apply w-full bg-slate-900/60 border border-slate-700 rounded px-3 py-2.5 text-sm text-slate-100 placeholder:text-slate-600 outline-none transition-colors focus:border-purple-500 focus:bg-slate-900 focus:ring-1 focus:ring-purple-500/40;
  }
  .cf-input[aria-invalid="true"] {
    @apply border-red-500/70 focus:border-red-400 focus:ring-red-500/30;
  }
  .cf-error {
    @apply mt-1.5 text-[11px] text-red-400;
  }
</style>

<script>
  const toast = document.getElementById("toast");
  const toastMsg = document.getElementById("toast-message");

  const showToast = (message: string) => {
    if (!toast || !toastMsg) return;
    toastMsg.innerText = message;
    toast.classList.remove("hidden");
    // Force layout reflow
    toast.offsetHeight;
    toast.classList.remove("translate-y-20", "opacity-0");

    setTimeout(() => {
      toast.classList.add("translate-y-20", "opacity-0");
      setTimeout(() => {
        toast.classList.add("hidden");
      }, 300);
    }, 2500);
  };

  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      e.preventDefault();

      const textToCopy = btn.getAttribute("data-copy") || "";
      if (!textToCopy) return;

      try {
        await navigator.clipboard.writeText(textToCopy);
        // Get translated message
        const isEn = document.documentElement.getAttribute("lang") === "en";
        const successMsg = isEn ? "Copied to clipboard!" : "¡Copiado al portapapeles!";
        showToast(successMsg);
      } catch (err) {
        const isEn = document.documentElement.getAttribute("lang") === "en";
        const errorMsg = isEn ? "Failed to copy to clipboard." : "Error al copiar al portapapeles.";
        showToast(errorMsg);
      }
    });
  });

  // ---- Contact form (Web3Forms) ----
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  if (form) {
    const KEY = form.dataset.key ?? "";
    const EMAIL = form.dataset.email ?? "";
    const MIN = Number(form.dataset.min ?? 20);
    const COOLDOWN_MS = 60_000;
    // Subject lines are for César's inbox, so they stay in Spanish regardless of the page language
    const REASON_LABEL: Record<string, string> = { job: "Vacante", freelance: "Proyecto freelance", other: "Otro" };

    const nameEl = form.querySelector<HTMLInputElement>("#cf-name")!;
    const emailEl = form.querySelector<HTMLInputElement>("#cf-email")!;
    const messageEl = form.querySelector<HTMLTextAreaElement>("#cf-message")!;
    const countEl = document.getElementById("cf-count");
    const submitBtn = document.getElementById("cf-submit") as HTMLButtonElement;
    const spinner = document.getElementById("cf-spinner");
    const labelIdle = document.getElementById("cf-label-idle");
    const labelSending = document.getElementById("cf-label-sending");
    const mailtoLink = document.getElementById("cf-mailto") as HTMLAnchorElement | null;

    const rules: [HTMLInputElement | HTMLTextAreaElement, (v: string) => boolean][] = [
      [nameEl, (v) => v.length >= 2],
      [emailEl, (v) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)],
      [messageEl, (v) => v.length >= MIN],
    ];

    const validate = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const rule = rules.find(([field]) => field === el)!;
      const ok = rule[1](el.value.trim());
      el.setAttribute("aria-invalid", String(!ok));
      document.getElementById(`${el.id}-error`)?.classList.toggle("hidden", ok);
      return ok;
    };

    // Validate on blur, then live once a field has been flagged
    for (const [el] of rules) {
      el.addEventListener("blur", () => { if (el.value.trim()) validate(el); });
      el.addEventListener("input", () => { if (el.getAttribute("aria-invalid") === "true") validate(el); });
    }

    const updateCount = () => {
      if (countEl) countEl.textContent = `${messageEl.value.length}/${messageEl.maxLength}`;
    };
    messageEl.addEventListener("input", updateCount);

    const showStatus = (status: "success" | "fallback" | "cooldown" | "error" | null) => {
      form.querySelectorAll<HTMLElement>("[data-status]").forEach((el) => {
        el.classList.toggle("hidden", el.dataset.status !== status);
      });
    };

    const setSending = (sending: boolean) => {
      submitBtn.disabled = sending;
      spinner?.classList.toggle("hidden", !sending);
      labelIdle?.classList.toggle("hidden", sending);
      labelSending?.classList.toggle("hidden", !sending);
    };

    const lastSent = () => {
      try { return Number(localStorage.getItem("contactSentAt") ?? 0); } catch { return 0; }
    };

    const buildMailto = (subject: string, body: string) =>
      `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      showStatus(null);

      // Flag every invalid field at once, then move focus to the first one
      const invalid = rules.map(([el]) => el).filter((el) => !validate(el));
      const firstInvalid = invalid[0];
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      if (Date.now() - lastSent() < COOLDOWN_MS) {
        showStatus("cooldown");
        return;
      }

      const data = new FormData(form);
      // Honeypot ticked: pretend it worked and send nothing
      if (data.get("botcheck")) {
        showStatus("success");
        return;
      }

      const name = nameEl.value.trim();
      const email = emailEl.value.trim();
      const message = messageEl.value.trim();
      const reason = REASON_LABEL[String(data.get("reason"))] ?? REASON_LABEL.other;
      const subject = `[Portafolio] ${reason} — ${name}`;
      const mailto = buildMailto(subject, `${message}\n\n— ${name} (${email})`);
      if (mailtoLink) mailtoLink.href = mailto;

      // No key configured yet: hand the message to the visitor's email app instead of losing it
      if (!KEY) {
        window.location.href = mailto;
        showStatus("fallback");
        return;
      }

      setSending(true);
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 15_000);
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            access_key: KEY,
            subject,
            from_name: "Portafolio · camr-portfolio.vercel.app",
            name,
            email,
            reason,
            message,
            botcheck: false,
          }),
          signal: controller.signal,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message ?? `HTTP ${res.status}`);

        try { localStorage.setItem("contactSentAt", String(Date.now())); } catch {}
        form.reset();
        updateCount();
        rules.forEach(([el]) => el.removeAttribute("aria-invalid"));
        showStatus("success");
      } catch (err) {
        console.warn("[contact] send failed:", err);
        showStatus("error");
      } finally {
        clearTimeout(timeout);
        setSending(false);
      }
    });
  }
</script>
