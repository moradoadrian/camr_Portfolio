---
import {
  siAngular,
  siTypescript,
  siJavascript,
  siHtml5,
  siTailwindcss,
  siPython,
  siPhp,
  siNodedotjs,
  siFirebase,
  siMysql,
  siPostgresql,
  siGit,
  siCapacitor,
} from "simple-icons";

// Renders the official Simple Icons brand mark. `fillOverride` is only used for
// Angular, whose current brand hex (#0F0F11) is near-black and invisible on this
// site's dark cards — brand kits ship a light variant for dark backgrounds, so we
// swap in that light tone while keeping the exact official path/shape.
function brandIcon(icon: { title: string; path: string; hex: string }, fillOverride?: string) {
  const fill = fillOverride ?? `#${icon.hex}`;
  return `<svg viewBox="0 0 24 24" class="w-full h-full object-contain" xmlns="http://www.w3.org/2000/svg"><title>${icon.title}</title><path d="${icon.path}" fill="${fill}"/></svg>`;
}

const techCategories = [
  {
    name: "FRONTEND_CORE",
    icon: "💻",
    skills: [
      {
        name: "Angular",
        years: "4+ Yrs",
        level: "Expert",
        progress: "■■■■■■■■■■",
        icon: brandIcon(siAngular, "#F4F4F5")
