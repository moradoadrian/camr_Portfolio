<section id="technologies" class="py-24 px-4 relative border-t border-slate-900 bg-slate-950 overflow-hidden">
  <!-- Glowing Background Orbs for atmospheric lighting -->
  <div class="absolute top-1/4 left-1/10 w-96 h-96 bg-purple-900/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/10 w-96 h-96 bg-blue-900/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-20">
      <h2 class="text-4xl md:text-5xl font-bold font-pixel text-purple-400 mb-4 tracking-wider" data-i18n="tech.title">
        &lt;Tech_Stack /&gt;
      </h2>
      <p class="font-mono text-xs text-slate-500 max-w-md mx-auto" data-i18n="tech.subtitle">
        // SISTEMA DE CAPACIDADES Y TECNOLOGÍAS INTEGRADAS
      </p>
    </div>

    <!-- Responsive Grid Layout -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {techCategories.map((category, index) => (
        <div class="tech-category group h-full">
          <div class="bg-slate-900/30 backdrop-blur-md border border-slate-800/80 p-6 h-full hover:border-purple-500/40 hover:bg-slate-900/50 hover:shadow-[0_0_30px_rgba(168,85,247,0.08)] transition-all duration-500 relative flex flex-col justify-between rounded-md">
            
            <div>
              <!-- Header with futuristic terminal look -->
              <div class="flex items-center justify-between mb-6 border-b border-slate-800/80 pb-4">
                <div class="flex items-center gap-3">
                  <span class="text-xl filter drop-shadow-[0_0_5px_rgba(168,85,247,0.3)] select-none">
                    {category.icon}
                  </span>
                  <h3 class="font-mono text-xs uppercase text-purple-400 font-bold tracking-widest">
                    {category.name}
                  </h3>
                </div>
                <span class="text-[9px] font-mono text-slate-600 select-none">
                  SEC_0{index + 1}
                </span>
              </div>

              <!-- Skill Grid -->
              <div class="grid grid-cols-2 gap-3">
                {category.skills.map((skill) => (
                  <div 
                    class={`flex flex-col items-center justify-between p-3 ${skill.name === 'Git' ? 'p-2' : ''} bg-slate-955/40 border border-slate-900 hover:bg-purple-950/15 hover:border-purple-500/30 transition-all duration-300 group/skill relative overflow-hidden rounded cursor-default min-h-[140px]`}
                    data-i18n-tooltip={`tooltip.${skill.name.toLowerCase().replace(/\s+/g, '').replace('.', '')}`}
                    data-tooltip=""
                  >
                    <!-- Tech Logo wrapper to enforce uniform size and centering -->
                    <div class={`tech-logo-wrapper ${skill.name === 'Git' ? 'w-[54px] h-[54px]' : 'w-12 h-12'} flex items-center justify-center mb-1`} set:html={skill.icon} />
                    
                    <div class="w-full text-center flex flex-col items-center">
                      <span class="text-[10px] font-mono font-bold text-slate-300 group-hover/skill:text-purple-300 transition-colors tracking-tight truncate w-full px-1">
                        {skill.name}
                      </span>
                      
                      <!-- Experience Level & Years -->
                      <span class="text-[8px] font-mono text-slate-500 tracking-tighter truncate w-full mt-0.5">
                        <span data-i18n={`tech.years.${skill.years.charAt(0)}`}>{skill.years}</span> · <span data-i18n={`tech.${skill.level.toLowerCase()}`}>{skill.level}</span>
                      </span>

                      <!-- Terminal Progress Bar indicator -->
                      <span class="text-[7px] font-mono text-purple-500/40 group-hover/skill:text-purple-400/80 transition-colors select-none tracking-tighter mt-1">
                        [{skill.progress}]
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Subtle retro-futuristic card corner decorators -->
            <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-purple-500/30 opacity-40 group-hover:opacity-100 group-hover:border-purple-500 transition-all duration-500"></div>
            <div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-purple-500/30 opacity-40 group-hover:opacity-100 group-hover:border-purple-500 transition-all duration-500"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Actualmente aprendiendo (Current Learning) Section -->
    <div class="mt-20 border-t border-slate-900/60 pt-16 text-center">
      <h3 class="text-sm font-bold uppercase tracking-widest text-slate-500 mb-6 font-mono" data-i18n="tech.learningTitle">
        // CURRENTLY LEARNING
      </h3>
      <div class="flex flex-wrap justify-center gap-3 max-w-xl mx-auto font-mono text-xs">
        <span class="px-3 py-1.5 bg-slate-900/80 border border-slate-800 text-slate-400 hover:border-purple-500/50 hover:text-purple-300 rounded transition-all cursor-default transform hover:-translate-y-0.5 shadow-sm hover:shadow-[0_0_10px_rgba(168,85,247,0.1)]">
          &gt; Docker
        </span>
        <span class="px-3 py-1.5 bg-slate-900/80 border border-slate-800 text-slate-400 hover:border-purple-500/50 hover:text-purple-300 rounded transition-all cursor-default transform hover:-translate-y-0.5 shadow-sm hover:shadow-[0_0_10px_rgba(168,85,247,0.1)]">
