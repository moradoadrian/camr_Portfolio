---
import { projects } from "../data/projects";

const EMAIL = "moradoadrian@gmail.com";
const CV = "/Ing-Cesar-Adrian-Morado-Rodriguez-2026.pdf";

// kind: "link" navigates, "external" opens a new tab, anything else is handled in the script.
// keywords hold both languages so search works whatever the page language is.
type Command = { id: string; group: string; key?: string; label: string; icon: string; kind: string; href?: string; keywords?: string };

const sections: Command[] = [
  { id: "home", group: "nav", key: "navbar.home", label: "Inicio", icon: "⌂", kind: "link", href: "/#top", keywords: "home inicio top" },
  { id: "about", group: "nav", key: "navbar.about", label: "Sobre Mí", icon: "◉", kind: "link", href: "/#about", keywords: "about me sobre mi perfil" },
  { id: "experience", group: "nav", key: "navbar.experience", label: "Experiencia", icon: "▤", kind: "link", href: "/#experience", keywords: "experience trabajo work ieeg flutter dart react native bodega prep educacion education" },
  { id: "certifications", group: "nav", key: "navbar.certifications", label: "Certificaciones", icon: "✦", kind: "link", href: "/#certifications", keywords: "certifications cursos" },
  { id: "projects", group: "nav", key: "navbar.projects", label: "Proyectos", icon: "▦", kind: "link", href: "/#projects", keywords: "projects portafolio portfolio" },
  { id: "terminal", group: "nav", key: "cmdk.terminal", label: "Terminal interactiva", icon: ">_", kind: "link", href: "/#terminal", keywords: "terminal shell consola console" },
  { id: "contact", group: "nav", key: "navbar.contact", label: "Contacto", icon: "✉", kind: "link", href: "/#contact", keywords: "contact contacto formulario form mensaje message" },
];

const projectCommands: Command[] = projects.map((p) => ({
  id: `project-${p.key}`,
  group: "projects",
  label: p.title,
  icon: "◆",
  kind: "link",
  href: `/projects/${p.key}`,
  keywords: `${p.tags.join(" ")} ${p.domain ?? ""} proyectos projects caso case study`,
}));

const actions: Command[] = [
  { id: "copy-email", group: "actions", key: "cmdk.copyEmail", label: "Copiar correo", icon: "⧉", kind: "copy", keywords: `copy email correo mail ${EMAIL}` },
  { id: "cv", group: "actions", key: "cmdk.cv", label: "Descargar CV", icon: "⇩", kind: "external", href: CV, keywords: "cv resume curriculum pdf download descargar" },
  { id: "lang", group: "actions", key: "cmdk.lang", label: "Cambiar idioma (ES / EN)", icon: "⇄", kind: "lang", keywords: "language idioma english español spanish ingles" },
  { id: "github", group: "actions", label: "GitHub", icon: "⌥", kind: "external", href: "https://github.com/moradoadrian", keywords: "github repos codigo code" },
  { id: "linkedin", group: "actions", label: "LinkedIn", icon: "in", kind: "external", href: "https://www.linkedin.com/in/moradoadrian/", keywords: "linkedin perfil profile" },
  { id: "whatsapp", group: "actions", label: "WhatsApp", icon: "☏", kind: "external", href: "https://wa.me/524614210058", keywords: "whatsapp telefono phone chat" },
];

const groups = [
  { id: "nav", key: "cmdk.groupNav", label: "Navegar", items: sections },
  { id: "projects", key: "cmdk.groupProjects", label: "Casos de estudio", items: projectCommands },
  { id: "actions", key: "cmdk.groupActions", label: "Acciones", items: actions },
];
---

<div id="cmdk" class="fixed inset-0 z-[120] hidden font-mono" role="dialog" aria-modal="true" aria-labelledby="cmdk-title">
  <div id="cmdk-backdrop" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

  <div class="relative mx-auto mt-[12vh] w-[min(640px,calc(100%-2rem))] bg-slate-950 border-2 border-purple-500/50 rounded-md shadow-[0_0_60px_rgba(168,85,247,0.25)] overflow-hidden">
    <h2 id="cmdk-title" class="sr-only" data-i18n="cmdk.title">Paleta de comandos</h2>

    <div class="flex items-center gap-3 px-4 border-b border-slate-800">
      <span class="text-purple-400 font-bold" aria-hidden="true">&gt;</span>
      <input
        id="cmdk-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
        data-i18n-placeholder="cmdk.placeholder"
        placeholder="Escribe un comando o busca..."
        class="flex-1 bg-transparent py-4 text-sm text-slate-100 placeholder:text-slate-600 !outline-none"
      />
      <kbd class="hidden sm:inline-block text-[10px] text-slate-500 border border-slate-700 rounded px-1.5 py-0.5">ESC</kbd>
    </div>

    <ul id="cmdk-list" role="listbox" class="max-h-[min(420px,55vh)] overflow-y-auto py-2 cmdk-scroll" aria-label="Comandos">
      {groups.map((g) => (
        <li role="presentation" data-group={g.id}>
          <p class="px-4 pt-3 pb-1.5 text-[10px] uppercase tracking-widest text-slate-500" data-i18n={g.key}>{g.label}</p>
          <ul role="group">
            {g.items.map((c) => (
              <li
                id={`cmdk-${c.id}`}
                role="option"
                aria-selected="false"
                data-cmd={c.id}
                data-kind={c.kind}
                data-href={c.href}
                data-keywords={c.keywords}
                class="cmdk-item mx-2 flex items-center gap-3 px-3 py-2.5 rounded cursor-pointer text-sm text-slate-300"
              >
                <span class="w-7 h-7 shrink-0 inline-flex items-center justify-center rounded border border-slate-800 bg-slate-900 text-[11px] text-purple-300" aria-hidden="true">{c.icon}</span>
                <span class="cmdk-label flex-1 truncate" data-i18n={c.key}>{c.label}</span>
                {c.kind === "external" && <span class="text-[10px] text-slate-600" aria-hidden="true">↗</span>}
                {c.kind === "copy" && <span class="cmdk-copied hidden text-[10px] text-emerald-400" data-i18n="contact.copied">¡Copiado!</span>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <p id="cmdk-empty" class="hidden px-4 py-8 text-center text-xs text-slate-500" data-i18n="cmdk.empty">Sin resultados. Prueba con "proyectos", "cv" o "angular".</p>

    <div class="flex items-center justify-between gap-4 px-4 py-2 border-t border-slate-800 text-[10px] text-slate-500">
      <span class="flex items-center gap-3">
        <span><kbd class="cmdk-kbd">↑</kbd><kbd class="cmdk-kbd">↓</kbd> <span data-i18n="cmdk.hintMove">navegar</span></span>
        <span><kbd class="cmdk-kbd">↵</kbd> <span data-i18n="cmdk.hintRun">ejecutar</span></span>
      </span>
      <span class="text-purple-500/70">~/cmd</span>
    </div>
  </div>
</div>

<style>
  .cmdk-item[aria-selected="true"] {
    @apply bg-purple-500/15 text-white;
  }
  .cmdk-item[aria-selected="true"] > span:first-child {
    @apply border-purple-500/60;
  }
  .cmdk-kbd {
    @apply inline-block min-w-[18px] text-center border border-slate-700 rounded px-1 mr-0.5 text-slate-400;
  }
  .cmdk-scroll {
    scrollbar-width: thin;
    scrollbar-color: #7c3aed transparent;
  }
</style>

<script>
  const root = document.getElementById("cmdk");
  const input = document.getElementById("cmdk-input") as HTMLInputElement | null;
  const empty = document.getElementById("cmdk-empty");

  if (root && input) {
    const items = [...root.querySelectorAll<HTMLElement>(".cmdk-item")];
    const groups = [...root.querySelectorAll<HTMLElement>("[data-group]")];
    let visible: HTMLElement[] = items;
    let active = 0;
    let lastFocus: Element | null = null;

    // Accent- and case-insensitive so "pagina" finds "página"
    const normalize = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

    const select = (i: number) => {
      if (!visible.length) return;
      active = (i + visible.length) % visible.length;
      visible.forEach((el, idx) => el.setAttribute("aria-selected", String(idx === active)));
      input.setAttribute("aria-activedescendant", visible[active].id);
      visible[active].scrollIntoView({ block: "nearest" });
    };

    const filter = () => {
      const terms = normalize(input.value.trim()).split(/\s+/).filter(Boolean);
      visible = items.filter((el) => {
        const haystack = normalize(`${el.querySelector(".cmdk-label")?.textContent ?? ""} ${el.dataset.keywords ?? ""}`);
        const match = terms.every((t) => haystack.includes(t));
        el.classList.toggle("hidden", !match);
        el.setAttribute("aria-selected", "false");
        return match;
      });
      groups.forEach((g) => g.classList.toggle("hidden", !g.querySelector(".cmdk-item:not(.hidden)")));
      empty?.classList.toggle("hidden", visible.length > 0);
      if (visible.length) select(0);
      else input.removeAttribute("aria-activedescendant");
    };

    const open = () => {
      if (!root.classList.contains("hidden")) return;
      lastFocus = document.activeElement;
      root.classList.remove("hidden");
      document.documentElement.style.overflow = "hidden";
      input.value = "";
      filter();
      input.focus();
    };

    const close = () => {
      if (root.classList.contains("hidden")) return;
      root.classList.add("hidden");
      document.documentElement.style.overflow = "";
      (lastFocus as HTMLElement | null)?.focus?.();
    };

    const run = async (el: HTMLElement | undefined) => {
      if (!el) return;
      const { kind, href } = el.dataset;

      if (kind === "copy") {
        try {
          await navigator.clipboard.writeText("moradoadrian@gmail.com");
          el.querySelector(".cmdk-copied")?.classList.remove("hidden");
          setTimeout(() => { el.querySelector(".cmdk-copied")?.classList.add("hidden"); close(); }, 700);
        } catch {
          location.href = "mailto:moradoadrian@gmail.com";
        }
        return;
      }

      if (kind === "lang") {
        const next = document.documentElement.lang === "en" ? "es" : "en";
        document.getElementById(`lang-btn-${next}`)?.click();
        close();
        return;
      }

      close();
      if (!href) return;
      if (kind === "external") {
        window.open(href, "_blank", "noopener");
      } else {
        // Same-page anchors scroll; anything else is a normal navigation
        const url = new URL(href, location.href);
        if (url.pathname === location.pathname && url.hash) {
          document.querySelector(url.hash)?.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, "", url.hash);
        } else {
          location.href = href;
        }
      }
    };

    input.addEventListener("input", filter);

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); select(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); select(active - 1); }
      else if (e.key === "Enter") { e.preventDefault(); run(visible[active]); }
      else if (e.key === "Tab") { e.preventDefault(); select(active + (e.shiftKey ? -1 : 1)); }
    });

    items.forEach((el) => {
      el.addEventListener("mousemove", () => {
        const idx = visible.indexOf(el);
        if (idx !== -1 && idx !== active) select(idx);
      });
      el.addEventListener("click", () => run(el));
    });

    document.getElementById("cmdk-backdrop")?.addEventListener("click", close);

    window.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        root.classList.contains("hidden") ? open() : close();
      } else if (e.key === "Escape" && !root.classList.contains("hidden")) {
        e.preventDefault();
        close();
      }
    });

    document.querySelectorAll("[data-cmdk-open]").forEach((btn) => btn.addEventListener("click", open));

    // Show ⌘ instead of Ctrl on Apple devices
    if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
      document.querySelectorAll(".cmdk-mod").forEach((el) => (el.textContent = "⌘"));
    }
  }
</script>
