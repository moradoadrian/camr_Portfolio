---
---
<section id="terminal" class="py-20 px-4 bg-slate-950 border-t border-slate-900 relative overflow-hidden">
  <div class="max-w-4xl mx-auto relative z-10 font-mono">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold font-pixel text-purple-400 mb-4 tracking-wider" data-i18n="terminal.title">
        &lt;Terminal /&gt;
      </h2>
      <p class="text-xs text-slate-500 max-w-md mx-auto" data-i18n="terminal.subtitle">
        // Interactive status console
      </p>
    </div>

    <!-- Terminal Window -->
    <div class="bg-slate-900/40 border-2 border-slate-800 rounded-md overflow-hidden hover:border-purple-500/40 transition-colors shadow-2xl">
      <!-- Title bar -->
      <div class="bg-slate-950 px-4 py-2 flex items-center justify-between border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
        </div>
        <span class="text-xs text-slate-500 font-bold font-mono">SYS_STATUS@CAMR_PORTFOLIO:~</span>
        <span class="text-xs text-purple-400 font-bold select-none">&gt;_</span>
      </div>

      <!-- Terminal Body -->
      <div class="p-6 md:p-8 space-y-6 text-sm text-slate-300 font-mono">
        <!-- whoami command -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-purple-500 font-bold">$</span>
            <span class="text-white font-bold" data-i18n="terminal.whoamiLabel">whoami</span>
          </div>
          <p class="pl-5 text-slate-400 leading-relaxed" data-i18n="terminal.whoamiVal">
            Desarrollador Frontend especializado en Angular
          </p>
        </div>

        <!-- current_focus command -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-purple-500 font-bold">$</span>
            <span class="text-white font-bold" data-i18n="terminal.focusLabel">current_focus</span>
          </div>
          <p class="pl-5 text-slate-400 leading-relaxed" data-i18n="terminal.focusVal">
            Angular, Firebase, IA, Cloud
          </p>
        </div>

        <!-- looking_for command -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-purple-500 font-bold">$</span>
            <span class="text-white font-bold" data-i18n="terminal.lookingLabel">looking_for</span>
          </div>
          <p class="pl-5 text-slate-400 leading-relaxed" data-i18n="terminal.lookingVal">
            Remote, Hybrid, Full-time
          </p>
        </div>

        <!-- Prompt line with blinking cursor -->
        <div class="flex items-center gap-2 pt-2 border-t border-slate-800/60">
          <span class="text-purple-500 font-bold">$</span>
          <span class="w-2.5 h-4 bg-purple-500 animate-pulse blink-cursor"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .blink-cursor {
    animation: blink 1s step-end infinite;
  }
</style>
