---
const experiences = [
  {
    key: "ieeg",
    company: "Instituto Electoral del Estado de Guanajuato (IEEG)",
    defaultPeriod: "Feb 2026 - Presente",
    defaultRole: "Ingeniero de Software",
    bulletsCount: 3
  },
  {
    key: "civil",
    company: "Dirección General del Registro Civil",
    defaultPeriod: "Abr 2024 - Feb 2026",
    defaultRole: "Desarrollador de Sistemas",
    bulletsCount: 3
  },
  {
    key: "mac",
    company: "Hospitales MAC",
    defaultPeriod: "Nov 2020 - Ene 2024",
    defaultRole: "Soporte y Desarrollo",
    bulletsCount: 3
  },
  {
    key: "infoexpo",
    company: "Infoexpo",
    defaultPeriod: "May 2018 - Nov 2020",
    defaultRole: "Desarrollador FrontEnd",
    bulletsCount: 3
  }
];

const education = [
  {
    key: "master",
    school: "UNIR México",
    defaultPeriod: "2024 - Actualmente",
    defaultDegree: "Maestría en Diseño y Desarrollo de la Interfaz de Usuario Web",
    statusKey: "enCurso"
  },
  {
    key: "ia",
    school: "UNIR México",
    defaultPeriod: "2024 - Actualmente",
    defaultDegree: "Plan Superior Universitario en IA para Desarrollo de Software y DevOps",
    statusKey: "enCurso"
  },
  {
    key: "eng",
    school: "Instituto Tecnológico de Roque",
    defaultPeriod: "2012 - 2017",
    defaultDegree: "Ingeniería en Tecnologías de la Información y Comunicaciones",
    statusKey: "titulado"
  }
];

const logos = {
  ieeg: `<svg class="w-4 h-4 text-purple-400 select-none object-contain" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>`,
  civil: `<svg class="w-4 h-4 text-purple-400 select-none object-contain" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.47 2 2 6.5 2 12a10 10 0 0010 10c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18a8 8 0 110-16 8 8 0 010 16zM9 13.5v-3l4-2 4 2v3l-4 2-4-2z"/></svg>`,
  mac: `<svg class="w-4 h-4 text-red-500 select-none object-contain" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M19 10.5h-5.5V5h-3v5.5H5v3h5.5V19h3v-5.5H19v-3z"/></svg>`,
  infoexpo: `<svg class="w-4 h-4 text-purple-400 select-none object-contain" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>`,
  unir: `<svg class="w-4 h-4 text-blue-400 select-none object-contain" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/><path d="M21.27 12.06l-9.27 5.06-9.27-5.06L1.6 12.78l10.4 5.67 10.4-5.67-1.13-.72z"/></svg>`,
  itroque: `<svg class="w-4 h-4 text-green-500 select-none object-contain" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>`
};

const eduLogos: Record<string, string> = {
  master: logos.unir,
  ia: logos.unir,
  eng: logos.itroque
};
---

<section id="experience" class="py-24 px-4 bg-slate-900/50 border-y border-slate-900 relative">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold text-center mb-16 font-pixel text-purple-400" data-i18n="exp.title">
      &lt;System_Log /&gt;
    </h2>

    <div class="grid md:grid-cols-2 gap-12 font-mono">
      <!-- Experience Column -->
      <div class="experience-container">
        <div class="bg-slate-950 border-2 border-slate-800 p-6 h-full relative group hover:border-purple-500/80 transition-all duration-300 rounded-md shadow-lg hover:shadow-[0_0_20px_rgba(168,85,247,0.06)]">
          <div class="absolute top-0 left-0 bg-slate-800 text-xs text-white px-3 py-1 group-hover:bg-purple-600 transition-all flex items-center gap-1.5 rounded-br-sm">
            <svg class="w-3.5 h-3.5 text-purple-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span data-i18n="exp.execHistory">EXECUTION_HISTORY</span>
          </div>
          <div class="mt-8 space-y-10 relative">
             <!-- Vertical Line Container -->
             <div class="absolute left-[7px] top-2 bottom-2 w-[2px] bg-slate-900 overflow-hidden">
               <div class="timeline-progress-line-exp w-full h-0 bg-purple-500 origin-top"></div>
             </div>

            {
              experiences.map((exp) => (
                <div class="relative pl-8 group/item">
                  <div class="absolute left-0 top-1.5 w-4 h-4 bg-slate-900 border border-purple-500 group-hover/item:bg-purple-500 transition-colors rounded-sm"></div>
                  
                  <div class="text-xs text-purple-400 mb-1 font-bold flex items-center gap-2">
                    <span set:html={logos[exp.key as keyof typeof logos]} class="shrink-0 scale-90" />
                    <span>[<span data-i18n={`exp.${exp.key}.period`}>{exp.defaultPeriod}</span>] :: {exp.company}</span>
                  </div>
                  <h4 class="text-lg font-bold text-white mb-3 group-hover/item:text-purple-300 transition-colors">
                    > <span data-i18n={`exp.${exp.key}.role`}>{exp.defaultRole}</span>
                  </h4>
                  <ul class="text-slate-400 text-sm leading-relaxed space-y-2 border-l-2 border-slate-800/80 pl-4 group-hover/item:border-purple-500/50 transition-colors list-none">
                    {Array.from({ length: exp.bulletsCount }).map((_, i) => (
                      <li class="relative pl-4 text-justify">
                        <span class="absolute left-0 text-purple-500 font-bold">&gt;</span>
                        <span data-i18n={`exp.${exp.key}.bullet${i + 1}`}>...</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <!-- Subtle retro-futuristic card corner decorators -->
          <div class="absolute top-0 right-0 w-2.5 h-2.5 border-t-2 border-r-2 border-slate-800 group-hover:border-purple-500 transition-colors"></div>
          <div class="absolute bottom-0 left-0 w-2.5 h-2.5 border-b-2 border-l-2 border-slate-800 group-hover:border-purple-500 transition-colors"></div>
        </div>
      </div>

      <!-- Education Column -->
      <div class="education-container">
        <div class="bg-slate-950 border-2 border-slate-800 p-6 h-full relative group hover:border-blue-500/80 transition-all duration-300 rounded-md shadow-lg hover:shadow-[0_0_20px_rgba(59,130,246,0.06)]">
          <div class="absolute top-0 left-0 bg-slate-800 text-xs text-white px-3 py-1 group-hover:bg-blue-600 transition-all flex items-center gap-1.5 rounded-br-sm">
            <svg class="w-3.5 h-3.5 text-blue-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
            </svg>
            <span data-i18n="exp.kernelTraining">KERNEL_TRAINING</span>
          </div>
          <div class="mt-8 space-y-10 relative">
             <!-- Vertical Line Container -->
             <div class="absolute left-[7px] top-2 bottom-2 w-[2px] bg-slate-900 overflow-hidden">
               <div class="timeline-progress-line-edu w-full h-0 bg-blue-500 origin-top"></div>
             </div>

            {
              education.map((edu) => (
                <div class="relative pl-8 group/item">
                  <div class="absolute left-0 top-1.5 w-4 h-4 bg-slate-900 border border-blue-500 group-hover/item:bg-blue-500 transition-colors rounded-sm"></div>
                  
                  <div class="text-xs text-blue-400 mb-1 font-bold flex items-center gap-2">
                    <span set:html={eduLogos[edu.key as keyof typeof eduLogos]} class="shrink-0 scale-90" />
                    <span>[<span data-i18n={`edu.${edu.key}.period`}>{edu.defaultPeriod}</span>] :: <span data-i18n={`exp.${edu.statusKey}`}>...</span></span>
                  </div>
                  <h4 class="text-lg font-bold text-white mb-2 group-hover/item:text-blue-300 transition-colors">
                    > <span data-i18n={`edu.${edu.key}.degree`}>{edu.defaultDegree}</span>
                  </h4>
                  <p class="text-slate-400 text-sm leading-relaxed border-l-2 border-slate-800 pl-4 group-hover/item:border-blue-500/50 transition-colors">
                    {edu.school}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Subtle retro-futuristic card corner decorators -->
          <div class="absolute top-0 right-0 w-2.5 h-2.5 border-t-2 border-r-2 border-slate-800 group-hover:border-blue-500 transition-colors"></div>
          <div class="absolute bottom-0 left-0 w-2.5 h-2.5 border-b-2 border-l-2 border-slate-800 group-hover:border-blue-500 transition-colors"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Cards Scroll entrance
  gsap.fromTo(".experience-container", 
    { opacity: 0, x: -30 },
    {
      scrollTrigger: {
        trigger: ".experience-container",
        start: "top bottom-=100",
        toggleActions: "play none none reverse",
      },
      opacity: 1,
      x: 0,
      duration: 1,
      ease: "power3.out",
    }
  );

  gsap.fromTo(".education-container", 
    { opacity: 0, x: 30 },
    {
      scrollTrigger: {
        trigger: ".education-container",
        start: "top bottom-=100",
        toggleActions: "play none none reverse",
      },
      opacity: 1,
      x: 0,
      duration: 1,
      ease: "power3.out",
      delay: 0.2,
    }
  );

  // Animated Line drawing
  gsap.to(".timeline-progress-line-exp", {
    scrollTrigger: {
      trigger: ".experience-container",
      start: "top 60%",
      end: "bottom 70%",
      scrub: true
    },
    height: "100%",
    ease: "none"
  });

  gsap.to(".timeline-progress-line-edu", {
    scrollTrigger: {
      trigger: ".education-container",
      start: "top 60%",
      end: "bottom 70%",
      scrub: true
    },
    height: "100%",
    ease: "none"
  });
</script>
